  payload   Json     @default("{}")
  storeId   String?  @map("store_id")
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([storeId])
  @@index([type])
  @@map("leads")
}

model Session {
  tokenHash  String   @id @map("token")

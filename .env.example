# Sanad Commerce — environment template.
# Copy to .env and fill in real values. Never commit .env.

# ---- Runtime ----
# Port the API listens on.
PORT=5000
# One of: development | test | production
NODE_ENV="development"

# ---- Database ----
# PostgreSQL connection string (local dev via docker-compose.yml).
DATABASE_URL="postgresql://sanad:sanad@localhost:5432/sanad"

# ---- Sessions & auth ----
# Secret used to HMAC session tokens before storage. REQUIRED in
# production with at least 32 characters; the app refuses to boot
# without it. This placeholder intentionally fails that check if copied
# verbatim. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates every active session (all merchants must log in again).
SESSION_SECRET="change-me-to-32-plus-chars"

# ---- CORS ----
# Comma-separated origins allowed to call /api with credentials (no wildcards).
CORS_ORIGIN="http://localhost:3000"

# ---- Reverse proxy ----
# "true" only when behind a trusted reverse proxy (production behind
# nginx/Caddy/Cloud Run). Controls Express trust-proxy + rate-limit IPs.
TRUST_PROXY="false"

# ---- Requests ----
# Max JSON body size (e.g. 256kb, 1mb).
JSON_BODY_LIMIT="256kb"
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# ---- Frontend (build-time) ----
# Base URL for API calls. Empty = same origin (vite dev proxy / served bundle).
VITE_API_URL=""

# ---- Demo data ----
# "true" ONLY for local demos: allows `npm run db:seed` content and demo login.
# Default off. Never enable in production without setting DEMO_MERCHANT_PASSWORD.
DEMO_MODE="false"
# DEMO_MERCHANT_PASSWORD="change-me-in-demo"

# ---- Admin ----
# There is no shared admin secret. Promote a merchant with SQL:
#   UPDATE merchants SET role='admin' WHERE email='owner@example.com';
# Admins can list all leads via GET /api/admin/leads.

# ---- Public URLs / storage ----
# Absolute base URL used by onboarding links and integrations.
APP_URL="http://localhost:3000"
# "local" is implemented. "s3" returns STORAGE_INTEGRATION_NOT_CONFIGURED
# until a real S3 adapter is added.
STORAGE_DRIVER="local"
STORAGE_DIR="data/uploads"
# Per-image upload limit in bytes (min 1 KB, max 20 MB).
MEDIA_MAX_BYTES="5242880"

# ---- AI assistant (optional) ----
# The assistant stays disabled unless both values are set. It calls an
# OpenAI-compatible /chat/completions endpoint; no content is fabricated
# without a provider.
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY=""
# AI_MODEL="gpt-4o-mini"

# ---- Online payments (optional, adapter required) ----
# Credentials alone do not enable online payments: a provider-specific
# adapter must also be installed. COD remains the only complete method.
# PAYMENT_PROVIDER="paymob"
# PAYMENT_SECRET_KEY=""

# ---- WhatsApp (optional) ----
# wa.me links work without these values. Automatic sending additionally
# requires an approved WhatsApp Cloud API template.
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_ID=""

# ---- Shipping carrier (optional) ----
# Shipping zones/rates/COD fees work manually without a carrier adapter.
# SHIPPING_PROVIDER=""
# SHIPPING_API_KEY=""


# Sanad Commerce — environment template.
# Copy to .env and fill in real values. Never commit .env.

# ---- Runtime ----
# Port the API listens on.
PORT=5000
# One of: development | test | production
NODE_ENV="development"

# ---- Database ----
# PostgreSQL connection string (local dev via docker-compose.yml).
DATABASE_URL="postgresql://sanad:sanad@localhost:5432/sanad"

# ---- Sessions & auth ----
# Secret used to HMAC session tokens before storage. REQUIRED in
# production with at least 32 characters; the app refuses to boot
# without it. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates every active session (all merchants must log in again).
SESSION_SECRET=""

# ---- CORS ----
# Comma-separated origins allowed to call /api with credentials (no wildcards).
CORS_ORIGIN="http://localhost:3000"

# ---- Reverse proxy ----
# "true" only when behind a trusted reverse proxy (production behind
# nginx/Caddy/Cloud Run). Controls Express trust-proxy + rate-limit IPs.
TRUST_PROXY="false"

# ---- Requests ----
# Max JSON body size (e.g. 256kb, 1mb).
JSON_BODY_LIMIT="256kb"
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# ---- Frontend (build-time) ----
# Base URL for API calls. Empty = same origin (vite dev proxy / served bundle).
VITE_API_URL=""

# ---- Demo data ----
# "true" ONLY for local demos: allows `npm run db:seed` content and demo login.
# Default off. Never enable in production without setting DEMO_MERCHANT_PASSWORD.
DEMO_MODE="false"
# DEMO_MERCHANT_PASSWORD="change-me-in-demo"

# ---- Admin ----
# There is no shared admin secret. Promote a merchant with SQL:
#   UPDATE merchants SET role='admin' WHERE email='owner@example.com';
# Admins can list all leads via GET /api/admin/leads.

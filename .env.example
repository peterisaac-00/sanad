# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- Sanad Commerce backend ----
PORT=5000
NODE_ENV="development"
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGIN="http://localhost:3000"
# PostgreSQL connection (see docker-compose.yml for local dev).
DATABASE_URL="postgresql://sanad:sanad@localhost:5432/sanad"
VITE_API_URL=""
# "true" only to trust X-Forwarded-For when behind a reverse proxy (production).
TRUST_PROXY="false"
JSON_BODY_LIMIT="256kb"
LOG_LEVEL="info"
# Demo seed data (demo store + demo merchant). Default off; never enable in production
# without setting DEMO_MERCHANT_PASSWORD.
DEMO_MODE="false"
# DEMO_MERCHANT_PASSWORD="change-me-in-demo"
# Optional: gates GET /api/leads listing further (callers must send x-admin-token).
# ADMIN_TOKEN="change-me"

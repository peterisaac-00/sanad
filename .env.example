# Sanad Commerce — environment template.
# Copy to .env and fill in real values. Never commit .env.

# ---- Runtime ----
# Port the API listens on.
PORT=5000
# One of: development | test | production
NODE_ENV="development"

# ---- Database ----
# PostgreSQL connection string (local dev via docker-compose.yml).
# docker compose requires this value and keeps PostgreSQL private to its network.
POSTGRES_PASSWORD="generate-a-long-random-password"
DATABASE_URL="postgresql://sanad:YOUR_POSTGRES_PASSWORD@localhost:5432/sanad"

# ---- Sessions & auth ----
# Secret used to HMAC session tokens before storage. REQUIRED in
# production with at least 32 characters; the app refuses to boot
# without it. This placeholder intentionally fails that check if copied
# verbatim. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates every active session (all merchants must log in again).
SESSION_SECRET="change-me-to-32-plus-chars"

# ---- CORS ----
# Comma-separated origins allowed to call /api with credentials (no wildcards).
CORS_ORIGIN="http://localhost:3000"

# ---- Reverse proxy ----
# Do NOT use "true": it trusts the whole X-Forwarded-For chain and lets any
# client spoof its IP. Use the number of trusted proxy hops (e.g. "1") or a
# comma-separated list of proxy IPs/CIDRs (e.g. "loopback,10.0.0.0/8").
# "loopback", "linklocal" and "uniquelocal" presets are accepted.
TRUST_PROXY="false"

# ---- Requests ----
# Max JSON body size (e.g. 256kb, 1mb).
JSON_BODY_LIMIT="256kb"
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# ---- Frontend (build-time) ----
# Base URL for API calls. Empty = same origin (vite dev proxy / served bundle).
VITE_API_URL=""

# ---- Demo data ----
# "true" ONLY for local demos: allows `npm run db:seed` content and demo login.
# Default off. Never enable in production without setting DEMO_MERCHANT_PASSWORD.
DEMO_MODE="false"
# DEMO_MERCHANT_PASSWORD="change-me-in-demo"

# ---- Platform administration ----
# Platform admins are a separate identity from merchants. There is no SQL
# promotion and Merchant.role never grants /admin access.
# The first super_admin is created at boot ONLY when both values are set.
# Password must be 12+ characters. Bootstrapping is idempotent: it creates a
# missing account and never resets an existing password, name, role, or MFA.
# Sign in at /admin, enable TOTP, then remove the password and restart.
ADMIN_BOOTSTRAP_EMAIL="peter@gmail.com"
 ADMIN_BOOTSTRAP_PASSWORD="peterisaacvr12"
 ADMIN_BOOTSTRAP_NAME="peter"

# ---- Public URLs / storage ----
# Absolute base URL used by verification/reset/tracking links and integrations.
APP_URL="http://localhost:3000"
# Only "local" is implemented. Selecting "s3" fails at startup because the S3
# adapter does not exist; it never silently accepts uploads.
STORAGE_DRIVER="local"
STORAGE_DIR="data/uploads"
# Per-image upload limit in bytes (min 1 KB, max 20 MB).
MEDIA_MAX_BYTES="5242880"
# Maximum width/height in pixels (256–12000). SVG/HTML uploads are rejected;
# JPEG/PNG/WebP/GIF are decoded, re-encoded, metadata-stripped and capped.
MEDIA_MAX_DIMENSION="6000"

# ---- Transactional email (optional but required for real verification) ----
# SMTP connection URL, e.g. smtp://user:pass@smtp.example.com:587.
# Set both SMTP_URL and EMAIL_FROM to enable delivery. Without them the API
# reports email as unconfigured and (outside production) returns one-time
# debug tokens so local development is never locked out.
# SMTP_URL=""
# EMAIL_FROM="Sanad <no-reply@example.com>"
# Require a verified email before login. In production the app refuses to
# boot when this is true but SMTP is not configured.
REQUIRE_EMAIL_VERIFICATION="false"
EMAIL_VERIFICATION_TTL_MINUTES="1440"
PASSWORD_RESET_TTL_MINUTES="60"

# ---- Tracking and 2FA secrets (optional; derived from SESSION_SECRET) ----
# Set explicit 32+ character secrets to rotate them independently. Rotating
# SESSION_SECRET also invalidates derived tracking links and TOTP encryption.
# TRACKING_SECRET=""
# TOTP_ENCRYPTION_KEY=""
TRACKING_TOKEN_TTL_DAYS="30"

# ---- Data retention / exports ----
CART_RETENTION_DAYS="30"
AUDIT_RETENTION_DAYS="365"
# Hard cap for CSV exports; larger exports return 413 EXPORT_TOO_LARGE.
EXPORT_MAX_ROWS="50000"

# ---- AI assistant (optional) ----
# The assistant stays disabled unless both values are set. It calls an
# OpenAI-compatible /chat/completions endpoint; no content is fabricated
# without a provider.
# OpenAI:
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY=""
# AI_MODEL="gpt-4o-mini"
# Google Gemini (OpenAI-compatible endpoint), keys from https://aistudio.google.com/apikey:
# AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# AI_API_KEY=""
# AI_MODEL="gemini-3.5-flash-lite"

# ---- Online payments (optional, adapter required) ----
# Credentials alone do not enable online payments: a provider-specific
# adapter must also be installed. COD remains the only complete method.
# PAYMENT_PROVIDER="paymob"
# PAYMENT_SECRET_KEY=""

# ---- WhatsApp (optional) ----
# wa.me links work without these values. Automatic sending additionally
# requires an approved WhatsApp Cloud API template.
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_ID=""

# ---- Shipping carrier (optional) ----
# Shipping zones/rates/COD fees work manually without a carrier adapter.
# SHIPPING_PROVIDER=""
# SHIPPING_API_KEY=""
